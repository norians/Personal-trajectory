---
import DefaultSocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const isNotesPage = Astro.locals.starlightRoute.id === 'apuntes' || Astro.locals.starlightRoute.id.startsWith('apuntes/');
---

{isNotesPage && (
	<a class="home-link" href="/" aria-label="Volver a la portada">
		<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
			<path d="m3 10 9-7 9 7" />
			<path d="M5 9v11h14V9M9 20v-6h6v6" />
		</svg>
		<span>Inicio</span>
	</a>
)}
<DefaultSocialIcons><slot /></DefaultSocialIcons>

<style>
	.home-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-inline-end: 0.75rem;
		color: var(--sl-color-text);
		font-size: 0.875rem;
		text-decoration: none;
	}

	.home-link:hover {
		color: var(--sl-color-text-accent);
	}

	@media (max-width: 50rem) {
		.home-link span {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}
	}
</style>